{
  // Landing page for grokmark.si, served as static assets from site/. Deploy with: npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "round-leaf-ec7d",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "grokmark.si", "custom_domain": true }],
  "assets": { "directory": "./site", "not_found_handling": "404-page" }
}
